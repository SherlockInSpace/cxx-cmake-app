{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Ninja, build/<preset>, compile_commands.json for clang-tidy and editors.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Development (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "tracy",
      "inherits": "base",
      "displayName": "Tracy zones (RelWithDebInfo)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_TRACY": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "displayName": "AddressSanitizer + UBSan (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "gcov coverage (Debug, GCC)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "APP_COVERAGE": "ON"
      }
    },
    {
      "name": "ci",
      "hidden": true,
      "inherits": "base",
      "description": "What CI builds: warnings are errors.",
      "cacheVariables": {
        "APP_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-debug",
      "inherits": "ci",
      "displayName": "CI Debug (-Werror)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-release",
      "inherits": "ci",
      "displayName": "CI Release (-Werror)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "tracy",
      "configurePreset": "tracy"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "coverage-report",
      "configurePreset": "coverage",
      "targets": [
        "coverage"
      ]
    },
    {
      "name": "ci-debug",
      "configurePreset": "ci-debug"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "tracy",
      "inherits": "base",
      "configurePreset": "tracy"
    },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "configurePreset": "asan-ubsan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "configurePreset": "coverage"
    },
    {
      "name": "ci-debug",
      "inherits": "base",
      "configurePreset": "ci-debug",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "junit.xml"
      }
    },
    {
      "name": "ci-release",
      "inherits": "base",
      "configurePreset": "ci-release",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "junit.xml"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        }
      ]
    },
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "tracy",
      "steps": [
        {
          "type": "configure",
          "name": "tracy"
        },
        {
          "type": "build",
          "name": "tracy"
        },
        {
          "type": "test",
          "name": "tracy"
        }
      ]
    },
    {
      "name": "asan-ubsan",
      "steps": [
        {
          "type": "configure",
          "name": "asan-ubsan"
        },
        {
          "type": "build",
          "name": "asan-ubsan"
        },
        {
          "type": "test",
          "name": "asan-ubsan"
        }
      ]
    },
    {
      "name": "coverage",
      "steps": [
        {
          "type": "configure",
          "name": "coverage"
        },
        {
          "type": "build",
          "name": "coverage"
        },
        {
          "type": "build",
          "name": "coverage-report"
        }
      ]
    },
    {
      "name": "ci-debug",
      "steps": [
        {
          "type": "configure",
          "name": "ci-debug"
        },
        {
          "type": "build",
          "name": "ci-debug"
        },
        {
          "type": "test",
          "name": "ci-debug"
        }
      ]
    },
    {
      "name": "ci-release",
      "steps": [
        {
          "type": "configure",
          "name": "ci-release"
        },
        {
          "type": "build",
          "name": "ci-release"
        },
        {
          "type": "test",
          "name": "ci-release"
        }
      ]
    }
  ]
}
